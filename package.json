{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugin-dcg",
  "version": "0.2.0",
  "description": "OpenCode plugin: checks every shell command with the dcg (destructive command guard) binary before it runs and blocks the destructive ones",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "tsc --noEmit && node --test test/*.test.ts"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "dcg",
    "destructive-command-guard",
    "safety",
    "guard",
    "shell",
    "plugin"
  ],
  "author": "trick77 (https://github.com/trick77)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trick77/opencode-plugin-dcg.git"
  },
  "homepage": "https://github.com/trick77/opencode-plugin-dcg#readme",
  "bugs": {
    "url": "https://github.com/trick77/opencode-plugin-dcg/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.18"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
